<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>IconAdapt.App</RootNamespace>
    <AssemblyName>Forma</AssemblyName>
    <Product>Forma</Product>
    <Title>Forma</Title>
    <Description>桌面图标适配工具</Description>
    <ApplicationIcon>Assets\IconAdapt.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IconAdapt.App.Smoke" />
    <Resource Include="Assets\IconAdapt.ico" />
    <ProjectReference Include="..\IconAdapt.Core\IconAdapt.Core.csproj" />
    <ProjectReference Include="..\IconAdapt.Windows\IconAdapt.Windows.csproj" />
    <ProjectReference Include="..\IconAdapt.Imaging\IconAdapt.Imaging.csproj" />
  </ItemGroup>
</Project>
