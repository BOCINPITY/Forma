<Window x:Class="IconAdapt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IconAdapt · 桌面图标适配" Icon="Assets/IconAdapt.ico" Width="1280" Height="820" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F8F8FC" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#8B8FA2"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,13"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    </Window.Resources>
    <Grid Background="#F8F8FC">
        <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#F0F0F8" BorderBrush="#E7E7F0" BorderThickness="0,0,1,0">
            <Grid Margin="16,30,16,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,36">
                    <Border Width="42" Height="42" CornerRadius="13" Background="#7465DE" HorizontalAlignment="Left" Margin="0,0,0,13">
                        <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Background="White" CornerRadius="2" Margin="1.5"/><Border Grid.Column="1" Background="#DAD3FF" CornerRadius="2" Margin="1.5"/><Border Grid.Row="1" Background="#DAD3FF" CornerRadius="2" Margin="1.5"/><Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="2" Margin="1.5"/></Grid>
                    </Border>
                    <TextBlock Text="IconAdapt" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="给桌面一点秩序" FontSize="11" Foreground="#8B8FA2" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding WorkspaceCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowWorkspace}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#7465DE"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="▦   图标工作台" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Command="{Binding HistoryCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowHistory}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#7465DE"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="↶   恢复记录" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="10,0,4,0">
                    <Border Background="#E7E6F4" CornerRadius="10" Padding="12" Margin="0,0,0,20"><TextBlock Text="本地处理，无需上传。&#10;备份会随操作自动保存。" FontSize="10" Foreground="#77768F" TextWrapping="Wrap" LineHeight="19"/></Border>
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontSize="11" Foreground="#979BAD"/>
                    <TextBlock Text="WINDOWS DESKTOP" FontSize="9" FontFamily="Segoe UI" Foreground="#A4A8BA" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="28,27,26,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="让每个图标，恰到好处。" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="统一留白、底板与圆角，保留你熟悉的应用标志。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowHistory, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="每一次改变，都有来路。" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="查看本机的操作批次，并安全恢复原始图标。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Top" Background="#EFECFC" CornerRadius="16" Padding="12,7" Margin="10,5,0,0"><TextBlock Text="本地预览" Foreground="#8573CF" FontSize="11"/></Border>
            </Grid>
            <Grid Grid.Row="1" Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#EAEAF1" BorderThickness="1" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="我的图标" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceLabel}" ToolTip="{Binding SourceLabel}" Foreground="#979BAD" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,10,0"/></StackPanel><Button Grid.Column="1" Content="重新扫描" Command="{Binding ScanCommand}" Padding="12,8" VerticalAlignment="Top"/></Grid>
                        <WrapPanel Grid.Row="1" Margin="0,16,0,16">
                            <Button Content="选择文件夹" Command="{Binding ChooseFolderCommand}" Padding="11,7" Margin="0,0,7,6"/>
                            <Button Content="桌面" Command="{Binding DesktopCommand}" Padding="11,7" Margin="0,0,7,6"/>
                            <Button Content="全选" Command="{Binding SelectAllCommand}" Padding="11,7" Margin="0,0,7,6"/>
                            <Button Content="清空" Command="{Binding SelectNoneCommand}" Padding="11,7" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding FocusedItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanEdit}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,9,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#F7F7FB" BorderBrush="#F0F0F6" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#8D7CE4"/><Setter TargetName="Tile" Property="Background" Value="#F3F0FD"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#BEB2EF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid Width="121" Height="157" ToolTip="{Binding Path}" Margin="8,8,8,7">
                                        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Right" ToolTip="选择此快捷方式"/>
                                        <Image Grid.Row="1" Source="{Binding DisplayImage}" Width="68" Height="68" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Margin="2,9,2,0"/>
                                        <TextBlock Grid.Row="3" Text="{Binding Status}" ToolTip="{Binding Detail}" Foreground="#9792AA" FontSize="10" TextAlignment="Center" Margin="0,6,0,0"/>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="30">
                                <TextBlock Text="▦" Foreground="#CDC6E8" FontSize="54" HorizontalAlignment="Center"/><TextBlock Text="这里还没有快捷方式" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,9"/><TextBlock Text="支持普通 .lnk 应用快捷方式。&#10;选择一个包含快捷方式的文件夹开始。" TextAlignment="Center" Foreground="{StaticResource Muted}" LineHeight="23" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="#F0EFF5" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,10,0,0"><Grid><TextBlock Text="{Binding SelectionLabel}" Foreground="#8B8FA2" FontSize="11"/><TextBlock Text="正在生成预览…" Foreground="#8573CF" FontSize="10" HorizontalAlignment="Right" Visibility="{Binding IsRendering, Converter={StaticResource BoolVisibility}}"/></Grid></Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#EAEAF1" BorderThickness="1" CornerRadius="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,21,20,20">
                            <TextBlock Text="风格检查器" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <Border Background="#F6F5FA" CornerRadius="12" Padding="13,15">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Image Source="{Binding FocusedItem.Original}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="原图标" Foreground="#9390A2" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="→" Foreground="#B5ACC9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,15"/><StackPanel Grid.Column="2"><Image Source="{Binding FocusedItem.Preview}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="适配效果" Foreground="#9390A2" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Grid>
                            </Border>
                            <TextBlock Text="{Binding FocusedItem.Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="11" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding FocusedItem.Detail}" Foreground="#B46C5A" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,5" MaxHeight="46" ToolTip="{Binding FocusedItem.Detail}"/>
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <TextBlock Text="底板风格" Style="{StaticResource SectionLabel}"/>
                                <ComboBox SelectedIndex="{Binding BackdropIndex}" Height="34" Padding="8,5" BorderBrush="#E6E5ED"><ComboBoxItem Content="柔和渐变"/><ComboBoxItem Content="纯色底板"/><ComboBoxItem Content="透明背景"/></ComboBox>
                                <TextBlock Text="背景颜色" Style="{StaticResource SectionLabel}" Margin="0,12,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Background="#7772EE" Command="{Binding ColorCommand}" CommandParameter="#7772EE" Width="29" Height="29" Padding="0" Margin="0,0,8,0" ToolTip="薰衣草紫"/>
                                    <Button Background="#5D9EC7" Command="{Binding ColorCommand}" CommandParameter="#5D9EC7" Width="29" Height="29" Padding="0" Margin="0,0,8,0" ToolTip="雾蓝"/>
                                    <Button Background="#62AC97" Command="{Binding ColorCommand}" CommandParameter="#62AC97" Width="29" Height="29" Padding="0" Margin="0,0,8,0" ToolTip="鼠尾草绿"/>
                                    <Button Background="#D79977" Command="{Binding ColorCommand}" CommandParameter="#D79977" Width="29" Height="29" Padding="0" Margin="0,0,8,0" ToolTip="暖杏"/>
                                    <Button Background="#697084" Command="{Binding ColorCommand}" CommandParameter="#697084" Width="29" Height="29" Padding="0" ToolTip="石墨灰"/>
                                </StackPanel>
                                <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Height="33" Padding="9,6" BorderBrush="#E6E5ED" FontFamily="Consolas" ToolTip="输入 #RRGGBB 十六进制颜色"/>
                                <TextBlock Text="{Binding StyleError}" Foreground="#BA6054" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Grid Margin="0,15,0,0"><TextBlock Text="图案大小" FontSize="11" Foreground="#8B8FA2"/><TextBlock Text="{Binding ScaleLabel}" HorizontalAlignment="Right" FontSize="11" Foreground="#8573CF"/></Grid>
                                <Slider Minimum="0.3" Maximum="0.9" Value="{Binding ContentScale}" SmallChange="0.01" LargeChange="0.05" ToolTip="调整图案在底板中的占比"/>
                                <Grid><TextBlock Text="圆角比例" FontSize="11" Foreground="#8B8FA2"/><TextBlock Text="{Binding RadiusLabel}" HorizontalAlignment="Right" FontSize="11" Foreground="#8573CF"/></Grid>
                                <Slider Minimum="0" Maximum="0.5" Value="{Binding CornerRadius}" SmallChange="0.01" LargeChange="0.05"/>
                                <CheckBox Content="按图案边界去除透明留白" IsChecked="{Binding CropTransparent}" FontSize="11" Margin="0,2,0,19"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer><Border Grid.Row="1" BorderBrush="#EFEDF5" BorderThickness="0,1,0,0" Padding="20,14,20,16"><StackPanel><Button Content="应用选中的图标" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Padding="15,13"/><TextBlock Text="自动备份 · 可从恢复记录还原" FontSize="10" Foreground="#A2A0B2" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel></Border></Grid>
                </Border>
            </Grid>
            <Border Grid.Row="1" Visibility="{Binding ShowHistory, Converter={StaticResource BoolVisibility}}" Background="White" BorderBrush="#EAEAF1" BorderThickness="1" CornerRadius="16" Padding="24">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="操作批次" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/><ListBox Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedBatch}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,11"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedBatch.Title, TargetNullValue=尚无操作记录}" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="每项独立备份。文件发生变化时会保留冲突，避免覆盖后续编辑。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,11,0,20"/><ListBox Grid.Row="2" ItemsSource="{Binding SelectedBatch.Items}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#EFEDF5" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#8573CF" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="3" Content="恢复这个批次的原图标" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0"/></Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="#8A7BE3" Background="#EAE7F5" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" FontSize="11" Foreground="#777489"/><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#9B98A9" FontSize="10" Margin="0,5,14,0" MaxHeight="45" ToolTip="{Binding Notice}"/></StackPanel><Button Grid.Column="1" Content="停止操作" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Padding="12,7" VerticalAlignment="Center"/></Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
