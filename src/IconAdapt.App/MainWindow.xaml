<Window x:Class="IconAdapt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:IconAdapt.App.Controls"
        Title="Forma · 桌面图标适配" Icon="Assets/IconAdapt.ico" Width="1220" Height="800" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F7F8F9" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource BodySize}" Language="zh-CN"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="OptionalText" TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}"><Grid>
                    <Border x:Name="CaptionHover" Background="#E7E9EC" controls:Motion.Opacity="0"/>
                    <Border x:Name="CaptionPressed" Background="#D7DAE0" controls:Motion.Opacity="0"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionHover" Property="controls:Motion.Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionPressed" Property="controls:Motion.Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="controls:Motion.Opacity" Value="0.38"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E2EAF5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SizeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="0,3"/><Setter Property="MinHeight" Value="25"/><Setter Property="FontSize" Value="{StaticResource CaptionSize}"/><Setter Property="Margin" Value="2"/></Style>
        <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="22"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Border x:Name="OuterFrame" BorderBrush="#D8DFEA" BorderThickness="1">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F4F6FB" Offset="0"/><GradientStop Color="#EDF1F9" Offset="0.55"/><GradientStop Color="#EEF0F9" Offset="1"/></LinearGradientBrush></Border.Background>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#BFFFFFFF" BorderBrush="#90FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <controls:BrandMark x:Name="BrandLogo" Width="28" Height="28" Margin="0,0,9,0"/>
                        <TextBlock x:Name="BrandName" Text="Forma" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Medium" VerticalAlignment="Center" ToolTip="{Binding Version, StringFormat=Forma v{0}}"/>
                    </StackPanel>
                    <Button x:Name="RestoreDefaultsButton" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0" Padding="10,6" FontSize="{StaticResource CaptionSize}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="恢复默认图标" ToolTip="恢复所有由 Forma 修改过的图标；多次适配会自动依次还原，无需选择记录。">
                        <StackPanel Orientation="Horizontal"><Path Data="M 3,5 A 5,5 0 1 1 2,10 M 3,1 L 3,5 7,5" Stroke="#7285A0" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="恢复默认图标"/></StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="ToggleMaximizeWindow" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原"/>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="CloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="16,12,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                <Grid>
                    <Border Style="{StaticResource PanelShadow}"/>
                    <Border CornerRadius="18" Background="#FDFFFFFF" BorderBrush="#E1E7F0" BorderThickness="1" Padding="14,15,14,12">
                    <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="图标库" FontSize="{StaticResource HeadingSize}" FontWeight="Normal"/><TextBlock Text="{Binding SourceShortLabel}" ToolTip="{Binding SourceTooltip}" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding DesktopCommand}" ToolTip="扫描桌面" Padding="8,6" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><Path Data="M 1,2 L 15,2 15,11 1,11 Z M 8,11 L 8,14 M 5,14 L 11,14" Stroke="#6B7F99" StrokeThickness="1.3" Stretch="Uniform" Width="15" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="桌面"/></StackPanel></Button>
                            <Button Command="{Binding ChooseFolderCommand}" ToolTip="打开包含快捷方式的文件夹" Padding="8,6" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><Path Data="M 1,4 L 1,2 6,2 8,4 15,4 15,13 1,13 Z" Stroke="#6B7F99" StrokeThickness="1.3" Fill="Transparent" StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="文件夹"/></StackPanel></Button>
                            <Button Command="{Binding ScanCommand}" Width="30" Padding="0" ToolTip="重新扫描" AutomationProperties.Name="重新扫描"><Path Data="M 13,5 A 6,6 0 1 0 14,9 M 13,1 L 13,5 9,5" Stroke="#6B7F99" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14"/></Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,11,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectionLabel}" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="全选" Command="{Binding SelectAllCommand}" Style="{StaticResource QuietButton}" Padding="8,3" MinHeight="25" FontSize="{StaticResource CaptionSize}"/><Button Content="清空" Command="{Binding SelectNoneCommand}" Style="{StaticResource QuietButton}" Padding="8,3" MinHeight="25" FontSize="{StaticResource CaptionSize}"/></StackPanel></Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="IconGallery" ItemsSource="{Binding Items}" SelectedItem="{Binding FocusedItem}" BorderThickness="0" Padding="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12"><Grid>
                                        <Border x:Name="HoverLayer" Background="#F0F5FE" CornerRadius="11" controls:Motion.Opacity="0" IsHitTestVisible="False"/>
                                        <Border x:Name="SelectionLayer" Background="#EAF2FF" BorderBrush="#B5D4FF" BorderThickness="1" CornerRadius="11" controls:Motion.Opacity="0" IsHitTestVisible="False"/>
                                        <ContentPresenter/>
                                    </Grid></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLayer" Property="controls:Motion.Opacity" Value="1"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionLayer" Property="controls:Motion.Opacity" Value="1"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#0A84FF"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Width="97" Height="108" ToolTip="{Binding Path}">
                                    <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="51"/><RowDefinition Height="22"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                                    <TextBlock Text="●" FontSize="7" Foreground="#B78A59" Margin="8,4,0,0" Visibility="{Binding HasIssue, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding IssueSummary}"/>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Right" Margin="0,4,4,0" ToolTip="选择此快捷方式" AutomationProperties.Name="选择图标"/>
                                    <controls:NativePixelImage Grid.Row="1" Source="{Binding DisplayImage}" PixelSize="48" AllowUpscale="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" Margin="5,1,5,0" FontSize="{StaticResource CaptionSize}"/>
                                    <TextBlock Grid.Row="3" Text="{Binding Status}" ToolTip="{Binding Detail}" Foreground="#65717D" TextAlignment="Center" FontSize="{StaticResource CaptionSize}"/>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="20">
                            <Border Width="64" Height="64" Background="#ECEFF3" CornerRadius="18" HorizontalAlignment="Center"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="#A4AFBD" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="添加你的桌面图标" FontSize="18" FontWeight="Normal" TextAlignment="Center" Margin="0,19,0,8"/><TextBlock Text="扫描桌面，或打开包含快捷方式的文件夹" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap"/>
                            <Button Content="打开文件夹" Command="{Binding ChooseFolderCommand}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="2,9,0,0">
                        <TextBlock Text="点击图标查看对比 · 勾选后批量应用" FontSize="{StaticResource CaptionSize}" Foreground="#65717D"/>
                        <Expander x:Name="NoticeExpander" Header="操作详情" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource Muted}" Margin="0,3,0,0">
                            <Border Background="#F5F8FD" BorderBrush="#E4EBF5" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,3,0,0">
                                <ScrollViewer x:Name="NoticeScroll" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="操作结果详情">
                                    <TextBlock x:Name="NoticeText" Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource Ink}" FontSize="{StaticResource CaptionSize}" Margin="0,0,8,0"/>
                                </ScrollViewer>
                            </Border>
                        </Expander>
                    </StackPanel>
                    </Grid></Border>
                </Grid>
                <Grid Grid.Column="2">
                    <Border Style="{StaticResource PanelShadow}"/>
                    <Border x:Name="Inspector" CornerRadius="18" Background="#F8FAFF" BorderBrush="#E0E7F2" BorderThickness="1" Padding="14,13,14,9">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel x:Name="PreviewPanel">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="效果预览" FontSize="{StaticResource SectionSize}" FontWeight="Medium" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="实际像素" Foreground="#65717D" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center" ToolTip="预览按屏幕物理像素 1:1 显示"/></Grid>
                            <Border Background="#EAF0FA" CornerRadius="9" Margin="0,7,0,7" Padding="2"><UniformGrid Columns="4">
                                <Button Content="32px" Command="{Binding PreviewSizeCommand}" CommandParameter="32"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SizeButton}"><Style.Triggers><DataTrigger Binding="{Binding PreviewPixelSize}" Value="32"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="48px" Command="{Binding PreviewSizeCommand}" CommandParameter="48"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SizeButton}"><Style.Triggers><DataTrigger Binding="{Binding PreviewPixelSize}" Value="48"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="64px" Command="{Binding PreviewSizeCommand}" CommandParameter="64"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SizeButton}"><Style.Triggers><DataTrigger Binding="{Binding PreviewPixelSize}" Value="64"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="96px" Command="{Binding PreviewSizeCommand}" CommandParameter="96"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SizeButton}"><Style.Triggers><DataTrigger Binding="{Binding PreviewPixelSize}" Value="96"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            </UniformGrid></Border>
                            <Border BorderBrush="#E1E8F6" BorderThickness="1" CornerRadius="15" Height="132">
                                <Border.Background><RadialGradientBrush GradientOrigin="0.75,0.25" Center="0.62,0.4" RadiusX="0.9" RadiusY="1"><GradientStop Color="#E5E9FF" Offset="0"/><GradientStop Color="#EDF5FF" Offset="0.55"/><GradientStop Color="#F9FBFF" Offset="1"/></RadialGradientBrush></Border.Background>
                                <Grid Margin="7,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                    <controls:NativePixelImage x:Name="OriginalPreview" AnimateSourceChanges="True" Source="{Binding FocusedItem.Original}" PixelSize="{Binding PreviewPixelSize}" AllowUpscale="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="原始图标" FontSize="{StaticResource CaptionSize}" Foreground="#65717D" HorizontalAlignment="Center" ToolTip="{Binding FocusedItem.SourceSizeLabel}"/>
                                    <Path Grid.Column="1" Data="M 1,5 L 11,5 M 7,1 L 11,5 7,9" Stroke="#95ACCD" StrokeThickness="1.2" Width="12" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <controls:NativePixelImage x:Name="AdaptedPreview" AnimateSourceChanges="True" Grid.Column="2" Source="{Binding FocusedItem.Preview}" PixelSize="{Binding PreviewPixelSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="适配效果" FontSize="{StaticResource CaptionSize}" Foreground="#65717D" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding FocusedItem.Name, TargetNullValue=选择一个图标开始预览, FallbackValue=选择一个图标开始预览}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="{StaticResource CaptionSize}" Margin="0,6,0,9"/>
                        </StackPanel>
                        <StackPanel x:Name="StyleControls" Grid.Row="1" IsEnabled="{Binding CanEdit}">
                            <Grid Margin="1,0,1,7"><TextBlock Text="适配设置" FontSize="{StaticResource SectionSize}" FontWeight="Medium" VerticalAlignment="Center"/><Button Content="macOS 预设" Command="{Binding MacPresetCommand}" Style="{StaticResource QuietButton}" Foreground="#007AFF" HorizontalAlignment="Right" Padding="5,2" MinHeight="25" FontSize="{StaticResource CaptionSize}"/></Grid>
                            <Border Background="White" CornerRadius="13" BorderBrush="#E7ECF5" BorderThickness="1" Padding="10,3,10,3"><StackPanel>
                                <Grid Height="34"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="底板" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/><ComboBox x:Name="BackdropSelector" Grid.Column="1" AutomationProperties.Name="底板风格" SelectedIndex="{Binding BackdropIndex}" Height="28" FontSize="{StaticResource CaptionSize}"><ComboBoxItem Content="柔和渐变"/><ComboBoxItem Content="纯色底板"/><ComboBoxItem Content="透明背景"/><ComboBoxItem Content="macOS 质感"/></ComboBox></Grid>
                                <Border Style="{StaticResource GroupDivider}" Margin="0"/>
                                <Grid Height="37"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="颜色" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" IsEnabled="{Binding CanChooseColor}"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsMacStyle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="77"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource Swatch}" Background="#7772EE" Command="{Binding ColorCommand}" CommandParameter="#7772EE" ToolTip="薰衣草紫"/><Button Style="{StaticResource Swatch}" Background="#5D9EC7" Command="{Binding ColorCommand}" CommandParameter="#5D9EC7" ToolTip="雾蓝"/><Button Style="{StaticResource Swatch}" Background="#62AC97" Command="{Binding ColorCommand}" CommandParameter="#62AC97" ToolTip="鼠尾草绿"/><Button Style="{StaticResource Swatch}" Background="#D79977" Command="{Binding ColorCommand}" CommandParameter="#D79977" ToolTip="暖杏"/></StackPanel><TextBox x:Name="ColorInput" Grid.Column="1" AutomationProperties.Name="背景颜色" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Height="26" FontFamily="Consolas" FontSize="{StaticResource CaptionSize}" Padding="5,3" ToolTip="十六进制颜色 #RRGGBB"/></Grid>
                                    <TextBlock Grid.Column="1" Text="跟随应用配色" FontSize="{StaticResource CaptionSize}" Foreground="#7184A0" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMacStyle}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Grid>
                                <Border Style="{StaticResource GroupDivider}" Margin="0"/>
                                <Grid Margin="0,5,0,1"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="21"/></Grid.RowDefinitions><TextBlock Text="图案大小" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}"/><TextBlock Text="{Binding ScaleLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontSize="{StaticResource CaptionSize}"/><Slider x:Name="ScaleSlider" Grid.Row="1" AutomationProperties.Name="图案大小" Minimum="0.3" Maximum="0.9" Value="{Binding ContentScale}" SmallChange="0.01" LargeChange="0.05" Height="20"/></Grid>
                                <Border Style="{StaticResource GroupDivider}" Margin="0"/>
                                <Grid Margin="0,5,0,0"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="21"/></Grid.RowDefinitions><TextBlock Text="圆角" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}"/><TextBlock Text="{Binding RadiusLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource NumberFont}" FontSize="{StaticResource CaptionSize}"/><Slider x:Name="RadiusSlider" Grid.Row="1" AutomationProperties.Name="圆角比例" Minimum="0" Maximum="0.5" Value="{Binding CornerRadius}" SmallChange="0.01" LargeChange="0.05" Height="20"/></Grid>
                                <Border Style="{StaticResource GroupDivider}" Margin="0"/>
                                <CheckBox x:Name="CropCheckBox" Style="{StaticResource ToggleSwitch}" Content="去除图案外围的透明留白" IsChecked="{Binding CropTransparent}" FontSize="{StaticResource CaptionSize}"/>
                            </StackPanel></Border>
                            <TextBlock Text="{Binding StyleError}" Style="{StaticResource OptionalText}" Foreground="#AC6545" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="{Binding FocusedItem.IssueSummary}" Style="{StaticResource OptionalText}" Foreground="#A66048" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap" Margin="0,0,0,3" ToolTip="{Binding FocusedItem.Diagnostic}"/>
                                    <TextBlock Text="{Binding FocusedItem.QualitySummary}" Style="{StaticResource OptionalText}" Foreground="#817566" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap" Margin="0,0,0,3" ToolTip="{Binding FocusedItem.SourceQualityNotice}"/>
                                    <Expander x:Name="DetailExpander" Header="图标与画质详情" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding FocusedItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                                        <StackPanel Margin="0,4,7,5"><Button Content="清晰优先" Command="{Binding ClarityPresetCommand}" Style="{StaticResource QuietButton}" Foreground="#007AFF" HorizontalAlignment="Left" FontSize="{StaticResource CaptionSize}" Padding="0,4"/><TextBlock Text="{Binding FocusedItem.SourceSizeLabel}" Margin="0,0,0,6"/><TextBlock Text="{Binding FocusedItem.PreviewHint}" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding FocusedItem.SourceQualityNotice}" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding FocusedItem.RenderNotes}" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding DetailLimitNotice}" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding FocusedItem.Diagnostic}" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Margin="0,0,0,6" ToolTip="{Binding FocusedItem.Detail}"/><TextBlock Text="{Binding FocusedItem.Path}" TextWrapping="Wrap" Foreground="#65717D"/></StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="Transparent">
                <Grid Margin="20,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Margin="0,0,9,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#9AA3AF"/><Style.Triggers><DataTrigger Binding="{Binding NoticeHasIssue}" Value="True"><Setter Property="Fill" Value="#BD8A52"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Grid.Column="1" Text="{Binding CompactStatus}" TextTrimming="CharacterEllipsis" Foreground="#65717D" FontSize="{StaticResource CaptionSize}" ToolTip="{Binding StatusDetail}"/></Grid>
                    <Button x:Name="NoticeDetailsButton" Grid.Column="1" Style="{StaticResource QuietButton}" Padding="9,4" MinHeight="28" FontSize="{StaticResource CaptionSize}" Content="{Binding NoticeSummary}" ToolTip="{Binding NoticeDetail}" Click="ShowNoticeDetails" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="停止操作" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" Padding="10,6"/><Button x:Name="ApplyButton" Content="应用选中图标" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Width="156" Height="34" Padding="15,6"/></StackPanel>
                </Grid>
            </Border>
            <ProgressBar Grid.Row="2" VerticalAlignment="Top" Height="2" BorderThickness="0" IsIndeterminate="True" Foreground="#0A84FF" Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
    </Border>
</Window>
