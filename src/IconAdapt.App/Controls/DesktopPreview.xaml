<UserControl x:Class="IconAdapt.App.Controls.DesktopPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IconAdapt.App.Controls"
             x:Name="Root" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="9,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="{StaticResource CaptionSize}"/>
        </Style>
        <Style x:Key="PixelButton" TargetType="Button" BasedOn="{StaticResource Segment}"><Setter Property="Width" Value="34"/><Setter Property="Padding" Value="0,4"/></Style>
        <Style x:Key="SceneLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#314864"/><Style.Triggers><DataTrigger Binding="{Binding IsDark, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="True"><Setter Property="Foreground" Value="#F1F5FC"/></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#EDF1F7" CornerRadius="8" Padding="2"><StackPanel Orientation="Horizontal">
                <Button x:Name="OriginalModeButton" Content="原始" Click="ShowOriginal" AutomationProperties.Name="查看原始图标"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Segment}"><Style.Triggers><DataTrigger Binding="{Binding IsAdapted, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="False"><Setter Property="Background" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <Button x:Name="AdaptedModeButton" Content="适配后" Click="ShowAdapted" AutomationProperties.Name="查看适配后的图标"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Segment}"><Style.Triggers><DataTrigger Binding="{Binding IsAdapted, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="True"><Setter Property="Background" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </StackPanel></Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="LightBackgroundButton" Click="ShowLight" ToolTip="明亮背景" AutomationProperties.Name="明亮背景" Padding="5" MinHeight="26" Margin="0,0,3,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Segment}"><Style.Triggers><DataTrigger Binding="{Binding IsDark, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="False"><Setter Property="Background" Value="#E7EFFB"/></DataTrigger></Style.Triggers></Style></Button.Style><Ellipse Width="15" Height="15" Fill="#D8E9F8" Stroke="#B8CADF"/></Button>
                <Button x:Name="DarkBackgroundButton" Click="ShowDark" ToolTip="深色背景" AutomationProperties.Name="深色背景" Padding="5" MinHeight="26"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Segment}"><Style.Triggers><DataTrigger Binding="{Binding IsDark, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="True"><Setter Property="Background" Value="#E7EFFB"/></DataTrigger></Style.Triggers></Style></Button.Style><Ellipse Width="15" Height="15" Fill="#354866" Stroke="#23344E"/></Button>
            </StackPanel>
            <Border Grid.Column="2" Background="#EDF1F7" CornerRadius="8" Padding="2" ToolTip="与右侧对比同步，以屏幕物理像素显示"><StackPanel Orientation="Horizontal">
                <Button Content="32" Command="{Binding SizeCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" CommandParameter="32" AutomationProperties.Name="32像素"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PixelButton}"><Style.Triggers><DataTrigger Binding="{Binding PixelSize, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="32"><Setter Property="Background" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <Button Content="48" Command="{Binding SizeCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" CommandParameter="48" AutomationProperties.Name="48像素"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PixelButton}"><Style.Triggers><DataTrigger Binding="{Binding PixelSize, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="48"><Setter Property="Background" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <Button Content="64" Command="{Binding SizeCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" CommandParameter="64" AutomationProperties.Name="64像素"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PixelButton}"><Style.Triggers><DataTrigger Binding="{Binding PixelSize, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="64"><Setter Property="Background" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <Button Content="96" Command="{Binding SizeCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" CommandParameter="96" AutomationProperties.Name="96像素"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PixelButton}"><Style.Triggers><DataTrigger Binding="{Binding PixelSize, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="96"><Setter Property="Background" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </StackPanel></Border>
        </Grid>
        <Grid Grid.Row="1">
            <local:DesktopBackdrop IsDark="{Binding IsDark, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}"/>
            <ListBox x:Name="DesktopItems" ItemsSource="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Background="Transparent" BorderThickness="0" Padding="12,14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnSceneSelectionChanged" AutomationProperties.Name="所选图标的桌面预览">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,4,10"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Cell" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Background" Value="#24FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="#38FFFFFF"/><Setter TargetName="Cell" Property="BorderBrush" Value="#99B8D4F5"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="#0A84FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel Width="110" Margin="3,9,3,6" ToolTip="{Binding Name}">
                        <Grid Margin="0,0,0,7">
                            <local:NativePixelImage x:Name="SceneOriginalImage" Source="{Binding Original}" PixelSize="{Binding PixelSize, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" AllowUpscale="False" HorizontalAlignment="Center"><local:NativePixelImage.Style><Style TargetType="local:NativePixelImage"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAdapted, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:NativePixelImage.Style></local:NativePixelImage>
                            <local:NativePixelImage x:Name="SceneAdaptedImage" Source="{Binding DesktopImage}" PixelSize="{Binding PixelSize, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" HorizontalAlignment="Center"><local:NativePixelImage.Style><Style TargetType="local:NativePixelImage"><Setter Property="AllowUpscale" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsAdapted, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Preview}" Value="{x:Null}"><Setter Property="AllowUpscale" Value="False"/></DataTrigger></Style.Triggers></Style></local:NativePixelImage.Style></local:NativePixelImage>
                        </Grid>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SceneLabel}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource CaptionSize}" Margin="2,0"/>
                        <TextBlock Text="{Binding DesktopStatus}" TextAlignment="Center" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap" Margin="1,3,1,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SceneLabel}"><Style.Triggers><DataTrigger Binding="{Binding IsAdapted, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItems.Count, RelativeSource={RelativeSource AncestorType={x:Type local:DesktopPreview}}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="先选择一些图标" FontSize="{StaticResource SectionSize}" TextAlignment="Center" Style="{StaticResource SceneLabel}"/><TextBlock Text="回到图标库勾选，查看它们放在一起的效果。" TextAlignment="Center" Style="{StaticResource SceneLabel}" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Margin="0,9,0,0"/><Button x:Name="ReturnToLibraryButton" Content="返回图标库" Click="ReturnToLibrary" HorizontalAlignment="Center" Margin="0,15,0,0" Padding="13,7"/></StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="模拟背景 · 仅展示勾选图标 · 实际像素" Foreground="{StaticResource Muted}" FontSize="{StaticResource CaptionSize}" Margin="2,8,0,0"/>
    </Grid>
</UserControl>
